{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runproof-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated list of extra origins allowed to call /mcp, beyond the
    // built-in localhost/127.0.0.1 dev-origin allowance. Set this to
    // wherever TrueForge (or any other MCP client that runs in a browser)
    // is actually served from. See src/routes/mcp.ts.
    "ALLOWED_MCP_ORIGINS": "http://localhost:8790",
    // Comma-separated list of extra origins allowed to make credentialed
    // (cookie-bearing) CORS requests against the operator console's API
    // surface, beyond the built-in http://localhost:3000 dev-origin
    // allowance. See src/index.ts.
    //
    // This must name wherever the console frontend is actually served
    // from, or a deployed console gets no CORS access at all and every
    // request from it — login included — fails in the browser. The value
    // below is the deployed runproof-frontend Worker (see
    // ../frontend/wrangler.jsonc and the "Live deployment" section of
    // ../README.md). An origin is scheme + host + port, matched exactly,
    // so the *.workers.dev subdomain here is account-specific and moving
    // either Worker means updating this. Leaving it empty is what breaks
    // a deployed console, so it is deliberately not empty.
    //
    // Updating this is necessary but NOT sufficient to move the console:
    // the session cookie is SameSite=Lax, so the console must also stay
    // on the same registrable domain as this API — same Cloudflare
    // account, or a custom domain shared by both. A console that is
    // merely allow-listed here but cross-site will pass CORS, log in,
    // and then 401 forever. See setSessionCookie in src/routes/auth.ts
    // and ../docs/cloudflare-deployment.md (which also covers what a
    // cross-site console would need before SameSite could be loosened).
    "ALLOWED_FRONTEND_ORIGINS": "https://runproof-frontend.sahilsilare.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runproof-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "./migrations"
    }
  ]
}
