{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runproof-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated list of extra origins allowed to call /mcp, beyond the
    // built-in localhost/127.0.0.1 dev-origin allowance. Set this to
    // wherever TrueForge (or any other MCP client that runs in a browser)
    // is actually served from. See src/routes/mcp.ts.
    "ALLOWED_MCP_ORIGINS": "http://localhost:8790",
    // Comma-separated list of extra origins allowed to make credentialed
    // (cookie-bearing) CORS requests against the operator console's API
    // surface, beyond the built-in http://localhost:3000 dev-origin
    // allowance. Set this to wherever the deployed console frontend
    // (runproof-frontend, see ../frontend/wrangler.jsonc) is actually
    // served from. See src/index.ts.
    "ALLOWED_FRONTEND_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runproof-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "./migrations"
    }
  ]
}
