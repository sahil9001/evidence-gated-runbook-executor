# Regenerated by every `next dev` / `next build`, and the two write
# different paths into it (.next/dev/types vs .next/types), so a tracked copy
# flips back and forth depending on which ran last. create-next-app ignores it
# for the same reason; Next rewrites it on demand.
next-env.d.ts
